<script>
(function(){
  "use strict";

  // ---------------- Day / Night auto theme ----------------
  function applyTheme(){
    var h = new Date().getHours();
    var isDay = h >= 6 && h < 18;
    var manual = window.__themeManual;
    if (manual === undefined){
      document.documentElement.setAttribute('data-theme', isDay ? 'day' : 'night');
    }
    var btn = document.getElementById('theme-toggle');
    var current = document.documentElement.getAttribute('data-theme');
    btn.textContent = current === 'day' ? '☀︎' : '☾';
  }
  applyTheme();
  setInterval(applyTheme, 60000);

  document.getElementById('theme-toggle').addEventListener('click', function(){
    var current = document.documentElement.getAttribute('data-theme');
    var next = current === 'day' ? 'night' : 'day';
    document.documentElement.setAttribute('data-theme', next);
    window.__themeManual = true;
    this.textContent = next === 'day' ? '☀︎' : '☾';
  });

  // ---------------- Key moments for countdown ----------------
  // Each moment: utc ISO time, title, local display string (with tz label), map query
  var moments = [
    {t:"2026-09-24T06:00:00Z", title:"成都酒店入住", local:"9/24 14:00 · 北京时间 UTC+8", q:"四川成都锦江区东安南路59号3楼"},
    {t:"2026-09-25T04:00:00Z", title:"成都酒店退房", local:"9/25 12:00 · 北京时间 UTC+8", q:"四川成都锦江区东安南路59号3楼"},
    {t:"2026-09-25T17:40:00Z", title:"3U3895 成都起飞", local:"9/26 01:40 · 北京时间 UTC+8", q:"成都天府国际机场"},
    {t:"2026-09-26T05:00:00Z", title:"抵达罗马菲乌米奇诺", local:"9/26 07:00 · 当地时间 UTC+2", q:"Rome Fiumicino Airport"},
    {t:"2026-09-26T08:40:00Z", title:"U22978 罗马起飞 → 尼斯", local:"9/26 10:40 · 当地时间 UTC+2", q:"Rome Fiumicino Airport"},
    {t:"2026-09-26T09:55:00Z", title:"抵达尼斯", local:"9/26 11:55 · 当地时间 UTC+2", q:"Nice Côte d'Azur Airport"},
    {t:"2026-09-26T14:00:00Z", title:"戛纳公寓入住", local:"9/26 16:00 · 当地时间 UTC+2", q:"45 Boulevard de la Croisette, Cannes"},
    {t:"2026-10-02T09:00:00Z", title:"戛纳公寓退房", local:"10/2 11:00 · 当地时间 UTC+2", q:"45 Boulevard de la Croisette, Cannes"},
    {t:"2026-10-02T12:55:00Z", title:"U24192 尼斯起飞 → 那不勒斯", local:"10/2 14:55 · 当地时间 UTC+2", q:"Nice Côte d'Azur Airport"},
    {t:"2026-10-02T14:20:00Z", title:"抵达那不勒斯", local:"10/2 16:20 · 当地时间 UTC+2", q:"Naples International Airport"},
    {t:"2026-10-02T15:40:00Z", title:"Ideal City Walk 入住", local:"10/2 17:40 · 当地时间 UTC+2", q:"Piazza Garibaldi 99, 80142 Napoli"},
    {t:"2026-10-03T05:30:00Z", title:"郊区铁路出发去索伦托", local:"10/3 07:30 · 当地时间 UTC+2", q:"Napoli Centrale"},
    {t:"2026-10-03T08:00:00Z", title:"渡轮出发去波西塔诺", local:"10/3 10:00 · 当地时间 UTC+2", q:"Sorrento port"},
    {t:"2026-10-04T06:00:00Z", title:"快船出发去卡普里岛", local:"10/4 08:00 · 当地时间 UTC+2", q:"Sorrento port"},
    {t:"2026-10-05T06:30:00Z", title:"渡轮出发去阿玛尔菲", local:"10/5 08:30 · 当地时间 UTC+2", q:"Sorrento port"},
