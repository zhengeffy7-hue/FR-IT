<!-- ================= ROUTE MAP ================= -->
<section class="section" id="map">
  <div class="section-head"><span class="section-num">02</span><h2 class="section-title">行程总览</h2></div>
  <div class="map-wrap">
    <svg viewBox="0 0 720 300" xmlns="http://www.w3.org/2000/svg">
      <path d="M20,240 C 60,180 90,260 130,200 S 190,120 230,150 S 300,230 340,190 S 410,90 450,120 S 520,210 560,170 S 630,70 690,60"
            fill="none" stroke="var(--line)" stroke-width="14" stroke-linecap="round"/>
      <path d="M20,240 C 60,180 90,260 130,200" fill="none" stroke="#1F6E75" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="1 9"/>
      <path d="M130,200 S 190,120 230,150" fill="none" stroke="#C6912E" stroke-width="3.5" stroke-linecap="round"/>
      <path d="M230,150 S 300,230 340,190" fill="none" stroke="#6C7B54" stroke-width="3.5" stroke-linecap="round"/>
      <path d="M340,190 S 410,90 450,120" fill="none" stroke="#AE4B2A" stroke-width="3.5" stroke-linecap="round"/>
