<!DOCTYPE html>
<html lang="zh-CN" data-theme="day">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>成都·罗马·南法·意南·巴黎 — 旅行手册</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Piazzolla:ital,wght@0,400;0,500;0,600;0,700;1,500;1,600&family=Archivo:wght@400;500;600;700&family=Archivo+Expanded:wght@600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#F5F0E7;
    --paper-soft:#EDE6DA;
    --ink:#20303A;
    --ink-soft:#4B5A62;
    --line:rgba(32,48,58,0.14);
    --sea:#1F6E75;
    --sea-soft:#DDEBE9;
    --gold:#C6912E;
    --gold-soft:#F3E4BE;
    --rust:#AE4B2A;
    --rust-soft:#F3DFD3;
    --sage:#6C7B54;
    --sage-soft:#E4E7D5;
    --card:#FCFAF5;
    --shadow: 0 1px 0 rgba(32,48,58,0.06);
    --radius: 3px;
    color-scheme: light;
  }
  html[data-theme="night"]{
    --paper:#182229;
    --paper-soft:#1F2B33;
    --ink:#EDE6D3;
    --ink-soft:#AEB9BC;
    --line:rgba(237,230,211,0.14);
    --sea:#5FB4B9;
    --sea-soft:#20363A;
    --gold:#E1B45C;
    --gold-soft:#332A18;
    --rust:#E08862;
    --rust-soft:#3A2620;
    --sage:#A3B383;
    --sage-soft:#2A2F20;
    --card:#1E2932;
    --shadow: 0 1px 0 rgba(0,0,0,0.3);
    color-scheme: dark;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;background:var(--paper);}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'Archivo',sans-serif;
    font-size:16px;
    line-height:1.55;
    transition:background .6s ease, color .6s ease;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:760px;margin:0 auto;padding:0 22px 120px;}
  a{color:inherit;}

  /* ---------- Header ---------- */
  header.hero{
    padding:56px 22px 40px;
    max-width:760px;margin:0 auto;
    border-bottom:1px solid var(--line);
  }
  .route-tag{
    font-family:'Archivo Expanded',sans-serif;
    font-size:12.5px;
    letter-spacing:.02em;
    color:var(--sea);
    font-weight:700;
    margin-bottom:14px;
  }
  h1.title{
    font-family:'Piazzolla',serif;
    font-weight:600;
    font-size:clamp(30px,6vw,44px);
    line-height:1.12;
    margin:0 0 14px;
    color:var(--ink);
  }
  h1.title em{font-style:italic;color:var(--sea);font-weight:500;}
  .hero-meta{
    display:flex;gap:20px;flex-wrap:wrap;
    font-size:14px;color:var(--ink-soft);
  }
  .hero-meta b{color:var(--ink);font-weight:600;}

  /* ---------- Now card ---------- */
  section.now{
    max-width:760px;margin:34px auto 0;padding:0 22px;
  }
  .now-card{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:26px 26px 24px;
    box-shadow:var(--shadow);
    position:relative;
    overflow:hidden;
  }
  .now-card::before{
    content:"";
    position:absolute; left:0; top:0; bottom:0; width:4px;
    background:var(--sea);
  }
  .now-label{
    font-size:12px; letter-spacing:.03em; color:var(--ink-soft);
    margin-bottom:6px;
  }
  .now-title{
    font-family:'Piazzolla',serif; font-weight:600; font-size:22px;
    margin-bottom:2px;
  }
  .now-sub{font-size:14px;color:var(--ink-soft);margin-bottom:20px;}
  .now-sub .tz{color:var(--sea);}
  .countdown{
    display:flex; gap:10px; flex-wrap:wrap;
  }
  .cd-unit{
    background:var(--paper-soft);
    border-radius:var(--radius);
    padding:10px 16px;
    min-width:64px;
    text-align:center;
  }
  .cd-num{
    font-family:'Piazzolla',serif; font-weight:700;
    font-size:28px; font-variant-numeric:tabular-nums;
    color:var(--sea);
  }
  .cd-unit span{display:block;font-size:11px;color:var(--ink-soft);margin-top:2px;}
  .now-map{
    display:inline-block;margin-top:18px;font-size:13.5px;
    color:var(--sea); text-decoration:none; border-bottom:1px solid var(--sea);
    padding-bottom:1px;
  }


  .now-card .cd-unit .cd-num{
    font-size:22px;
  }
  .now-card .now-title{
    font-size:28px;
  }

  /* ---------- theme toggle ---------- */
  .theme-toggle{
    position:fixed; right:16px; bottom:16px; z-index:50;
    width:38px;height:38px;border-radius:50%;
    background:var(--card); border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;
    cursor:pointer; font-size:16px; box-shadow:var(--shadow);
    color:var(--ink);
  }

  /* ---------- section titles ---------- */
  .section{max-width:760px;margin:64px auto 0;padding:0 22px;}
  .section-head{
    display:flex; align-items:baseline; gap:12px; margin-bottom:22px;
  }
  .section-num{
    font-family:'Piazzolla',serif; font-style:italic; font-weight:500;
    color:var(--sea); font-size:14px;
  }
  h2.section-title{
    font-family:'Piazzolla',serif; font-weight:600;
    font-size:24px; margin:0; color:var(--ink);
  }

  /* ---------- Route map ---------- */
  .map-wrap{
    background:var(--card); border:1px solid var(--line); border-radius:var(--radius);
    padding:18px 12px 8px;
  }
  .map-wrap svg{width:100%; height:auto; display:block;}
  .map-legend{
    display:flex; flex-wrap:wrap; gap:14px 20px; padding:14px 10px 4px;
    font-size:12.5px; color:var(--ink-soft);
  }
  .map-legend span{display:inline-flex;align-items:center;gap:6px;}
  .dot{width:8px;height:8px;border-radius:50%;display:inline-block;}

  /* ---------- confirmed bookings ---------- */
  .booking-group{margin-bottom:26px;}
  .booking-group h3{
    font-family:'Archivo Expanded',sans-serif; font-size:13px; letter-spacing:.02em;
    color:var(--ink-soft); text-transform:none; margin:0 0 10px;
    padding-bottom:6px; border-bottom:1px solid var(--line);
  }
  /* ---------- visual flight cards ---------- */
  .flight-card{
    position:relative;
    overflow:hidden;
    background:#142B35;
    color:#F7F3EA;
    border-radius:18px;
    padding:22px 22px 20px;
    margin-bottom:14px;
    box-shadow:0 10px 28px rgba(32,48,58,.10);
  }
  .flight-card::after{
    content:"";
    position:absolute;
    width:170px;height:170px;
    right:-70px;bottom:-105px;
    border:1px solid rgba(255,255,255,.08);
    border-radius:50%;
  }
  .flight-top{
    display:flex; align-items:center; justify-content:space-between; gap:12px;
    margin-bottom:17px;
  }
  .flight-index{
    font-family:'Archivo Expanded',sans-serif;
    font-size:11px; letter-spacing:.12em;
    color:rgba(247,243,234,.68);
  }
  .flight-airline{
    font-size:12px; color:rgba(247,243,234,.72);
  }
  .flight-main{
    display:grid;
    grid-template-columns:1fr auto 1fr;
    align-items:center;
    gap:12px;
  }
  .flight-point{min-width:0;}
  .flight-point.right{text-align:right;}
  .flight-code-big{
    font-family:'Archivo Expanded',sans-serif;
    font-weight:700;
    font-size:clamp(30px,7vw,43px);
    line-height:1;
    letter-spacing:-.04em;
    color:#fff;
  }
  .flight-city{
    margin-top:8px;
    font-size:13px;
    color:rgba(247,243,234,.72);
  }
  .flight-arrow{
    text-align:center;
    min-width:72px;
    color:#9ED4D3;
  }
  .flight-arrow-line{
    display:flex; align-items:center; gap:7px;
    justify-content:center;
    font-size:19px;
  }
  .flight-arrow-line::before{
    content:"";
    width:38px; height:1px;
    background:rgba(158,212,211,.55);
  }
  .flight-arrow-line::after{
    content:"→";
    font-size:20px;
    line-height:1;
  }
  .flight-number{
    margin-top:5px;
    font-size:11px;
    color:rgba(247,243,234,.55);
    letter-spacing:.04em;
  }
  .flight-datebar{
    display:grid;
    grid-template-columns:1fr auto 1fr;
    align-items:end;
    gap:10px;
    margin-top:22px;
    padding-top:14px;
    border-top:1px solid rgba(255,255,255,.13);
  }
  .flight-datebar .time{
    font-family:'Piazzolla',serif;
    font-size:18px;
    font-weight:600;
    color:#fff;
  }
  .flight-datebar .label{
    display:block;
    margin-top:2px;
    font-size:10.5px;
    color:rgba(247,243,234,.55);
  }
  .flight-datebar .duration{
    text-align:center;
    font-size:11px;
    color:#9ED4D3;
  }
  .flight-datebar .right-time{text-align:right;}
  .flight-note{
    margin:10px 2px 0;
    font-size:11.5px;
    color:var(--ink-soft);
  }
  @media (max-width:520px){
    .flight-card{padding:18px 16px 17px; border-radius:15px;}
    .flight-code-big{font-size:30px;}
    .flight-arrow{min-width:52px;}
    .flight-arrow-line::before{width:24px;}
    .flight-datebar .time{font-size:16px;}
  }

  .hotel-card{
    background:var(--card); border:1px solid var(--line); border-radius:var(--radius);
    padding:16px 18px; margin-bottom:10px;
  }
  .hotel-name{font-weight:600; font-size:15px; margin-bottom:3px;}
  .hotel-nights{
    display:inline-block; font-size:11.5px; color:var(--sea);
    background:var(--sea-soft); padding:2px 8px; border-radius:20px; margin-left:8px;
    vertical-align:middle;
  }
  .hotel-addr{font-size:13.5px; color:var(--ink-soft); margin-top:4px;}
  .hotel-addr a{color:var(--sea); text-decoration:none; border-bottom:1px solid var(--sea);}
  .hotel-dates{font-size:12.5px; color:var(--ink-soft); margin-top:6px;}

  /* ---------- day itinerary ---------- */
  details.day{
    border-bottom:1px solid var(--line);
  }
  details.day:first-of-type{border-top:1px solid var(--line);}
  details.day summary{
    list-style:none; cursor:pointer;
    display:flex; align-items:center; gap:16px;
    padding:18px 4px;
  }
  details.day summary::-webkit-details-marker{display:none;}
  .day-date{
    font-family:'Piazzolla',serif; font-weight:600; font-size:20px;
    min-width:74px; color:var(--ink);
  }
  .day-date small{display:block; font-size:11.5px; font-weight:400; color:var(--ink-soft);}
  .day-headline{flex:1; font-size:14.5px; color:var(--ink-soft);}
  .day-headline b{color:var(--ink); font-weight:600;}
  .day-caret{
    font-size:12px; color:var(--sea); transition:transform .25s ease;
  }
  details[open] .day-caret{transform:rotate(90deg);}
  .day-body{padding:0 4px 22px 4px;}
  .day-nav-btn{
    display:inline-block; font-size:13px; color:var(--sea); text-decoration:none;
    border:1px solid var(--sea); border-radius:20px; padding:5px 14px; margin-bottom:16px;
  }
  .plan-row{
    display:flex; gap:16px; padding:9px 0; border-top:1px solid var(--line);
  }
  .plan-row:first-of-type{border-top:none;}
  .plan-time{
    min-width:88px; font-size:13px; color:var(--ink-soft); font-variant-numeric:tabular-nums;
    padding-top:1px;
  }
  .plan-content{flex:1; font-size:14.5px;}
  .plan-content a{color:var(--sea); text-decoration:none; border-bottom:1px solid var(--sea);}
  .plan-note{
    display:block; margin-top:4px; font-size:12.5px;
  }
  .badge{
    display:inline-block; font-size:11px; padding:1px 8px; border-radius:20px;
    margin-left:6px; vertical-align:middle; font-weight:600;
  }
  .badge.book{background:var(--rust-soft); color:var(--rust);}
  .badge.tip{background:var(--gold-soft); color:var(--gold);}

  /* ---------- todo ---------- */
  ul.todo{list-style:none; margin:0; padding:0;}
  ul.todo li{
    padding:12px 0 12px 26px; border-bottom:1px solid var(--line);
    font-size:14.5px; position:relative;
  }
  ul.todo li:first-child{border-top:1px solid var(--line);}
  ul.todo li::before{
    content:"—"; position:absolute; left:0; color:var(--sea);
  }

  /* ---------- tips ---------- */
  .tip-grid{
    display:grid; grid-template-columns:1fr 1fr; gap:14px;
  }
  @media (max-width:520px){.tip-grid{grid-template-columns:1fr;}}
  .tip-card{
    background:var(--card); border:1px solid var(--line); border-radius:var(--radius);
    padding:16px 18px;
  }
  .tip-card h4{
    margin:0 0 6px; font-family:'Piazzolla',serif; font-size:15px; font-weight:600;
    color:var(--sea);
  }
  .tip-card p{margin:0; font-size:13.5px; color:var(--ink-soft);}

  footer{
    max-width:760px;margin:70px auto 0;padding:22px;
    font-size:12px;color:var(--ink-soft); text-align:center;
    border-top:1px solid var(--line);
  }
</style>
</head>
<body>

<header class="hero">
  <div class="route-tag">CHENGDU → ROME → CÔTE D'AZUR → NAPOLI → SORRENTO → ROME → PARIS</div>
  <h1 class="title">意大利 · 法国<br><em>十七天</em>行程手册</h1>
  <div class="hero-meta">
    <span><b>2026.09.24</b> — <b>2026.10.10</b></span>
